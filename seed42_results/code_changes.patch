+                         f"{diff.min():.3f} | {diff.max():.3f} |")
+
+    fa = []
+    fa.append(f"# Failure Analysis — TN3K test set (seed {seed})\n")
+    fa.append("_Auto-generated by `generate_deliverables.py` from `qualitative_cases.csv` "
+              "(per-case test Dice of the best-EMA checkpoint of each model)._\n")
+    fa.append(f"## 1. Failure counts (Dice < {fail_thr}) by lesion scale\n")
+    fa.append(_md_table(fail_tbl) + "\n")
+    small_fail_rates = {m: (cases_df[cases_df['category'] == 'small'][dice_col[m]] < fail_thr).mean()
+                        for m in models_present}
+    large_fail_rates = {m: (cases_df[cases_df['category'] == 'large'][dice_col[m]] < fail_thr).mean()
+                        for m in models_present}
+    fa.append(f"Small lesions fail at {min(small_fail_rates.values()):.1%}–{max(small_fail_rates.values()):.1%} "
+              f"across models, versus {min(large_fail_rates.values()):.1%}–{max(large_fail_rates.values()):.1%} "
+              "for large lesions.\n")
+    fa.append(f"## 2. Cases that every model fails (Dice < {fail_thr})\n")
+    fa.append(f"{len(all_fail)} of {len(cases_df)} test cases are failed by all {len(others)} models "
+              f"(small: {all_fail_by_cat['small']}, medium: {all_fail_by_cat['medium']}, "
+              f"large: {all_fail_by_cat['large']}). These are failures of the shared backbone/recipe, "
+              "not of any one auxiliary loss.\n")
+    fa.append("## 3. Ten hardest cases (lowest mean Dice across models)\n")
