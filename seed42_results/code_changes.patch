+    print(f"Saved: {fa_path}")
+
+    # ── 8. Research findings ─────────────────────────────────────────────────
+    def _fmt_delta(v, nd=4):
+        return f"{v:+.{nd}f}"
+
+    rf = []
+    rf.append(f"# Research Findings — UltraLight VM-UNet on TN3K (fold 0, seed {seed})\n")
+    rf.append("_Auto-generated by `generate_deliverables.py` from the CSVs in this folder. "
