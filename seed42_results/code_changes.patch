+    all_fail = cases_df[np.all([cases_df[dice_col[m]] < fail_thr for m in others], axis=0)]
+    all_fail_by_cat = all_fail['category'].value_counts().reindex(cats, fill_value=0)
+
+    worst = cases_df.assign(mean_dice=cases_df[[dice_col[m] for m in others]].mean(axis=1)) \
