+def _paired_bootstrap(diff, n_boot=10000, seed=0):
+    """Mean of paired per-case differences with a 95% bootstrap CI."""
+    rng = np.random.default_rng(seed)
+    diff = np.asarray(diff, dtype=float)
+    idx = rng.integers(0, len(diff), size=(n_boot, len(diff)))
+    means = diff[idx].mean(axis=1)
+    lo, hi = np.percentile(means, [2.5, 97.5])
+    return float(diff.mean()), float(lo), float(hi)
+
+
+def _md_table(df, floatfmt=4):
+    cols = list(df.columns)
+    lines = ['| ' + ' | '.join(str(c) for c in cols) + ' |',
+             '|' + '|'.join('---' for _ in cols) + '|']
+    for _, row in df.iterrows():
+        cells = []
+        for c in cols:
+            v = row[c]
+            cells.append(f"{v:.{floatfmt}f}" if isinstance(v, (float, np.floating)) else str(v))
+        lines.append('| ' + ' | '.join(cells) + ' |')
+    return '\n'.join(lines)
+
+
+def write_text_reports(out_dir, seed=42):
+    """Writes ablation_study_summary.csv, RESEARCH_FINDINGS.md and failure_analysis.md."""
+    def _read(name):
+        p = os.path.join(out_dir, name)
+        return pd.read_csv(p) if os.path.exists(p) else None
+
+    test_df  = _read('final_test_comparison.csv')
+    scale_df = _read('lesion_scale_analysis.csv')
+    eff_df   = _read('model_efficiency_benchmark.csv')
+    train_df = _read('training_summary.csv')
+    cases_df = _read('qualitative_cases.csv')
+    if test_df is None or scale_df is None or cases_df is None:
+        print("[Reports] final_test_comparison / lesion_scale_analysis / qualitative_cases missing — "
+              "run the full generator first. Skipping written reports.")
+        return
+
+    base = 'E1 Baseline (E1-R*)'
+    models_present = [m for m in ABLATION_COMPONENTS if m in set(test_df['model'])]
+    dice_col = {m: f'{m}_dice' for m in models_present}
+
+    # ── 7. Ablation summary ──────────────────────────────────────────────────
+    t = test_df.set_index('model')
+    s = scale_df.set_index('model')
+    tr = train_df.set_index('experiment') if train_df is not None else None
+    base_row, base_scale = t.loc[base], s.loc[base]
+    ablation_rows = []
+    for m in models_present:
+        bnd, cons = ABLATION_COMPONENTS[m]
+        row = {
+            'model': m,
+            'boundary_loss': 'yes' if bnd else 'no',
+            'consistency_loss': 'yes' if cons else 'no',
+            'best_val_dice': float(tr.loc[m, 'best_val_dice_mean']) if tr is not None and m in tr.index else np.nan,
+            'test_dice': t.loc[m, 'test_dice'],
+            'test_iou': t.loc[m, 'test_iou'],
+            'biou_d7': t.loc[m, 'biou_d7'],
+            'bf1': t.loc[m, 'bf1'],
+            'hd95_px': t.loc[m, 'hd95_px'],
+            'small_dice': s.loc[m, 'small_dice'],
+            'delta_test_dice_vs_E1': round(t.loc[m, 'test_dice'] - base_row['test_dice'], 4),
+            'delta_biou_d7_vs_E1': round(t.loc[m, 'biou_d7'] - base_row['biou_d7'], 4),
+            'delta_bf1_vs_E1': round(t.loc[m, 'bf1'] - base_row['bf1'], 4),
+            'delta_hd95_vs_E1': round(t.loc[m, 'hd95_px'] - base_row['hd95_px'], 2),
+            'delta_small_dice_vs_E1': round(s.loc[m, 'small_dice'] - base_scale['small_dice'], 4),
+        }
+        if m != base:
